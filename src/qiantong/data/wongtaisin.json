[
  {
    "number": 1,
    "name": "姜公封相",
    "level": "上上签",
    "poem": [
      "靈籤求得第一枝",
      "龍虎風雲際會時",
      "一旦凌霄揚自樂",
      "任君來往赴瑤池"
    ]
  },
  {
    "number": 2,
    "name": "王道真誤入桃源",
    "level": "上吉签",
    "poem": [
      "枮木逢春盡發新",
      "花香葉茂蝶來頻",
      "桃源競鬭千紅紫",
      "一片漁舟誤入津"
    ]
  },
  {
    "number": 3,
    "name": "魯班伐木",
    "level": "中平签",
    "poem": [
      "牛山之木皆常美",
      "獨惜斧工盡伐他",
      "大器大材無足用",
      "矩規不準怎為槎"
    ]
  },
  {
    "number": 4,
    "name": "燕子教飛",
    "level": "中吉签",
    "poem": [
      "調雛紫燕在簷前",
      "對語呢喃近午天",
      "或往或來低復起",
      "有時剪破綠楊煙"
    ]
  },
  {
    "number": 5,
    "name": "陶淵明栽花",
    "level": "中吉签",
    "poem": [
      "東園昨夜狂風急",
      "萬紫千紅亦盡傾",
      "幸有惜花人起早",
      "培回根本復栽生"
    ]
  },
  {
    "number": 6,
    "name": "蘇東坡遊滕王閣",
    "level": "上吉签",
    "poem": [
      "一片孤帆萬里回",
      "管弦嘔啞且停杯",
      "如雲勝友談風月",
      "暢叙幽情極樂哉"
    ]
  },
  {
    "number": 7,
    "name": "丁山射雁",
    "level": "中平签",
    "poem": [
      "秋來征雁向南歸",
      "紅葉紛紛滿院飛",
      "砧搗城頭聲切耳",
      "江楓如火在漁磯"
    ]
  },
  {
    "number": 8,
    "name": "鵲巢鳩居",
    "level": "下下签",
    "poem": [
      "鳴鳩爭奪鵲巢居",
      "賓主參差意不舒",
      "滿嶺喬松蘿蔦附",
      "且猜詩語是何如"
    ]
  },
  {
    "number": 9,
    "name": "蘇秦不第",
    "level": "中平签",
    "poem": [
      "一輪月鏡掛空中",
      "偶被浮雲障叠重",
      "玉匣何時光氣吐",
      "誰人借我一狂風"
    ]
  },
  {
    "number": 10,
    "name": "蘇秦不第",
    "level": "中平签",
    "poem": [
      "一輪月鏡掛空中",
      "偶被浮雲障叠重",
      "玉匣何時光氣吐",
      "誰人借我一狂風"
    ]
  },
  {
    "number": 11,
    "name": "漢文帝賞柳",
    "level": "上吉签",
    "poem": [
      "楊柳垂隄鎖綠烟",
      "日長三起又三眠",
      "往來紫燕紛飛舞",
      "嬝娜迎風倩我憐"
    ]
  },
  {
    "number": 12,
    "name": "蜃樓海市",
    "level": "下下签",
    "poem": [
      "蜃樓海市幻無邊",
      "萬丈擎空接上天",
      "或被狂風忽吹散",
      "有時仍聚結青烟"
    ]
  },
  {
    "number": 13,
    "name": "孟浩然尋梅",
    "level": "中平签",
    "poem": [
      "為愛幽閒多種竹",
      "買春賞雨在茅屋",
      "醉時臥倒杏花邊",
      "怕聽鶯兒驚夢熟"
    ]
  },
  {
    "number": 14,
    "name": "陶淵明醉酒",
    "level": "中平签",
    "poem": [
      "為愛幽閒多種竹",
      "買春賞雨在茅屋",
      "醉時臥倒杏花邊",
      "怕聽鶯兒驚夢熟"
    ]
  },
  {
    "number": 15,
    "name": "唐明皇遊月殿",
    "level": "上吉签",
    "poem": [
      "仙槎一葉泛中流",
      "月殿蟾宮任爾游",
      "盈耳霓裳聲暫歇",
      "酒詩吟飲幾時休"
    ]
  },
  {
    "number": 16,
    "name": "牧童歸家",
    "level": "中吉签",
    "poem": [
      "天邊鴉背夕陽回",
      "隴外兒童跨犢來",
      "羗笛頻吹聲切耳",
      "短長腔調樂何哉"
    ]
  },
  {
    "number": 17,
    "name": "杜鵑",
    "level": "下下签",
    "poem": [
      "杜鵑啼血淚悲聲",
      "聲怨霜寒夢乍驚",
      "驚動異鄉為異客",
      "客心更觸故園情"
    ]
  },
  {
    "number": 18,
    "name": "杜鵑",
    "level": "下下签",
    "poem": [
      "杜鵑啼血淚悲聲",
      "聲怨霜寒夢乍驚",
      "驚動異鄉為異客",
      "客心更觸故園情"
    ]
  },
  {
    "number": 19,
    "name": "伏羲畫八卦",
    "level": "中吉签",
    "poem": [
      "乾卦三連號太陽",
      "潛龍勿用第一章",
      "其中爻象能參透",
      "百福駢臻大吉昌"
    ]
  },
  {
    "number": 20,
    "name": "天上仙花",
    "level": "中平签",
    "poem": [
      "天上仙花難問種",
      "人間塵事幾多更",
      "前程已注公私簿",
      "罰賞分明濁與清"
    ]
  },
  {
    "number": 21,
    "name": "吳穩之會宴",
    "level": "中吉签",
    "poem": [
      "秋水伊人各一方",
      "天南地北恨偏長",
      "相思詩問憑誰寄",
      "不盡淒涼幾斷腸"
    ]
  },
  {
    "number": 22,
    "name": "他鄉作客",
    "level": "下下签",
    "poem": [
      "秋水伊人各一方",
      "天南地北恨偏長",
      "相思詩問憑誰寄",
      "不盡淒涼幾斷腸"
    ]
  },
  {
    "number": 23,
    "name": "夢中得寶",
    "level": "中平签",
    "poem": [
      "邯鄲一夢幻無邊",
      "數載身榮是熟眠",
      "換却錦衣歸故里",
      "睡醒還記在心田"
    ]
  },
  {
    "number": 24,
    "name": "秦琼賣馬",
    "level": "下下签",
    "poem": [
      "詩酒琴棋可解愁",
      "座中無客樂難休",
      "或彈或唱誰知美",
      "吟飲須多亦是憂"
    ]
  },
  {
    "number": 25,
    "name": "五岳泰山",
    "level": "上吉签",
    "poem": [
      "群山擾擾朝中嶽",
      "有似為臣列鵠班",
      "拱立兩行齊整肅",
      "自居此地豈無歡"
    ]
  },
  {
    "number": 26,
    "name": "水月鏡花",
    "level": "中平签",
    "poem": [
      "花影遲遲侵砌上",
      "遙知月鏡掛長空",
      "忽聞鶴淚聲淒切",
      "早買歸舟返里中"
    ]
  },
  {
    "number": 27,
    "name": "蟻子知時",
    "level": "中平签",
    "poem": [
      "天晴粉蝶翻衣曬",
      "又看庭前蟻陣排",
      "隊伍整齊趨或退",
      "時開時合思何佳"
    ]
  },
  {
    "number": 28,
    "name": "白司馬被貶",
    "level": "中平签",
    "poem": [
      "船泊潯陽月夜天",
      "琵琶一曲動人憐",
      "相思兩地憑誰寄",
      "白雪催人上鬂巔"
    ]
  },
  {
    "number": 29,
    "name": "王羲之賞菊",
    "level": "中吉签",
    "poem": [
      "鱸魚作膾菊花黃",
      "美酒盈樽近晚涼",
      "泛棹正當潮上侯",
      "這般佳景樂無央"
    ]
  },
  {
    "number": 30,
    "name": "貴妃受劫",
    "level": "下下签",
    "poem": [
      "傾國傾城媚百生",
      "六宮粉黛盡無名",
      "馬嵬山下魂飛去",
      "至今明皇長恨情"
    ]
  },
  {
    "number": 31,
    "name": "漁翁遇風失東西",
    "level": "下下签",
    "poem": [
      "狂風驟雨打船蓬",
      "溪畔桃花盡落紅",
      "驚醒漁翁春夢熟",
      "持篙撐去失西東"
    ]
  },
  {
    "number": 32,
    "name": "蘇武牧羊",
    "level": "中平签",
    "poem": [
      "十九年前海上辛",
      "節旄彫敗逐沙塵",
      "餐毛嚼雪誰憐我",
      "惟有羊兒作伴群"
    ]
  },
  {
    "number": 33,
    "name": "曹操走難",
    "level": "中平签",
    "poem": [
      "曹操雖有深謀計",
      "智慧難暪諸葛侯",
      "試看東風都可借",
      "更能流馬木成牛"
    ]
  },
  {
    "number": 34,
    "name": "大舜耕田",
    "level": "中吉签",
    "poem": [
      "大舜雖耕在歷山",
      "心常孝順兩囂頑",
      "田中之象同家象",
      "善惡分明即此間"
    ]
  },
  {
    "number": 35,
    "name": "唐僧取經",
    "level": "中吉签",
    "poem": [
      "天將降任此其人",
      "筋骨先勞苦彼身",
      "莫謂景佳來可易",
      "貧窮富貴有前因"
    ]
  },
  {
    "number": 36,
    "name": "陶淵明歸家",
    "level": "中吉签",
    "poem": [
      "此事真如到岸船",
      "何憂風水不相全",
      "舉頭便見前村落",
      "屋角陽斜爨已煙"
    ]
  },
  {
    "number": 37,
    "name": "王羲之釣魚",
    "level": "上吉签",
    "poem": [
      "歸去來兮仕官閒",
      "室堪容膝亦為安",
      "南窗寄傲談詩酒",
      "倚杖徘徊飽看山"
    ]
  },
  {
    "number": 38,
    "name": "陶淵明辭官歸隱",
    "level": "中吉签",
    "poem": [
      "歸去來兮仕官閒",
      "室堪容膝亦為安",
      "南窗寄傲談詩酒",
      "倚杖徘徊飽看山"
    ]
  },
  {
    "number": 39,
    "name": "夷齊讓園",
    "level": "中平签",
    "poem": [
      "夷齊不忍食周粟",
      "兄弟心甘採蕨餐",
      "讓國名應垂萬古",
      "可憐餓倒首陽山"
    ]
  },
  {
    "number": 40,
    "name": "伯牙碎琴",
    "level": "下下签",
    "poem": [
      "人世知音能有幾",
      "碎琴都為子期亡",
      "墳前灑盡千行淚",
      "隔別陰陽各一方"
    ]
  },
  {
    "number": 41,
    "name": "張騫遇仙姬",
    "level": "中吉签",
    "poem": [
      "月明散步到花欄",
      "無策焉能勦滅奸",
      "幸有貂嬋思定國",
      "英雄難過美人關"
    ]
  },
  {
    "number": 42,
    "name": "王允遇貂嬋",
    "level": "中吉签",
    "poem": [
      "月明散步到花欄",
      "無策焉能勦滅奸",
      "幸有貂嬋思定國",
      "英雄難過美人關"
    ]
  },
  {
    "number": 43,
    "name": "韓文公諫君",
    "level": "下下签",
    "poem": [
      "只因直諫怒天顏",
      "晝夜難離在馬鞍",
      "主僕奔忙神亦倦",
      "更加雪重擁藍關"
    ]
  },
  {
    "number": 44,
    "name": "唐天寶賞牡丹",
    "level": "中吉签",
    "poem": [
      "滿園春色閗新粧",
      "意似爭妍奪國香",
      "到底是誰君麗首",
      "牡丹艷冠百花場"
    ]
  },
  {
    "number": 45,
    "name": "王質遇仙",
    "level": "中平签",
    "poem": [
      "黃柑數盒獻曹公",
      "剖看原來肉盡空",
      "怒動奸雄揮鐵斧",
      "奔忙身入萬羊中"
    ]
  },
  {
    "number": 46,
    "name": "左慈戲曹",
    "level": "下下签",
    "poem": [
      "黃柑數盒獻曹公",
      "剖看原來肉盡空",
      "怒動奸雄揮鐵斧",
      "奔忙身入萬羊中"
    ]
  },
  {
    "number": 47,
    "name": "魯肅取荊州",
    "level": "中平签",
    "poem": [
      "遙遙千里來西蜀",
      "欲問荊州那日還",
      "劉備不言聲淚下",
      "自思無策轉吳間"
    ]
  },
  {
    "number": 48,
    "name": "文君賣酒",
    "level": "中平签",
    "poem": [
      "繡閣聽琴自起思",
      "改粧寅夜最歡時",
      "可憐沽酒臨邛市",
      "才子佳人兩下廚"
    ]
  },
  {
    "number": 49,
    "name": "司馬相如題橋",
    "level": "中吉签",
    "poem": [
      "記得當年伍子胥",
      "潛奔難渡幸逢漁",
      "欲將寶劍相持贈",
      "大義交朋卻也辭"
    ]
  },
  {
    "number": 50,
    "name": "伍子胥出關",
    "level": "中吉签",
    "poem": [
      "記得當年伍子胥",
      "潛奔難渡幸逢漁",
      "欲將寶劍相持贈",
      "大義交朋卻也辭"
    ]
  },
  {
    "number": 51,
    "name": "周成王封弟",
    "level": "中平签",
    "poem": [
      "剪桐雖是作兒嬉",
      "封弟成圭語不移",
      "何以偽為成實事",
      "言因無戲故如斯"
    ]
  },
  {
    "number": 52,
    "name": "天地人三才",
    "level": "中平签",
    "poem": [
      "上清下濁成天地",
      "清濁相凝便作人",
      "爾欲籤求明白事",
      "且將三等細明分"
    ]
  },
  {
    "number": 53,
    "name": "孟嘗君",
    "level": "中吉签",
    "poem": [
      "珠履三千客孟嘗",
      "誰人識得有膺揚",
      "其中彈鋏歸來者",
      "便是英雄志莫當"
    ]
  },
  {
    "number": 54,
    "name": "莊周蝶夢",
    "level": "中平签",
    "poem": [
      "莊周酣眠成蝶夢",
      "翩翩飛入百花叢",
      "天香探得歸來後",
      "猶在高床暖枕中"
    ]
  },
  {
    "number": 55,
    "name": "吳隱之除官歸隱",
    "level": "中平签",
    "poem": [
      "浦號沉香遺舊恨",
      "渡江猶憶古人心",
      "可憐當日辭官去",
      "雖有馨留不易尋"
    ]
  },
  {
    "number": 56,
    "name": "桃木劍化龍",
    "level": "中吉签",
    "poem": [
      "安知此劍不成龍",
      "見水都應出袖中",
      "他日飛騰千萬里",
      "上空妖矯有雲從"
    ]
  },
  {
    "number": 57,
    "name": "秦穆公大敗",
    "level": "下下签",
    "poem": [
      "秦師大敗在殽山",
      "三帥皆擒盡放還",
      "蹇叔諫言因不聽",
      "倒戈捨甲返秦間"
    ]
  },
  {
    "number": 58,
    "name": "秦穆公大敗",
    "level": "下下签",
    "poem": [
      "秦師大敗在殽山",
      "三帥皆擒盡放還",
      "蹇叔諫言因不聽",
      "倒戈捨甲返秦間"
    ]
  },
  {
    "number": 59,
    "name": "吳王寵西施",
    "level": "下下签",
    "poem": [
      "澣溪紗女美無雙",
      "媚至吳王國破亡",
      "最惱東施效顰笑",
      "山雞豈可勝鸞凰"
    ]
  },
  {
    "number": 60,
    "name": "太白和番",
    "level": "中平签",
    "poem": [
      "和番醉筆似雲煙",
      "日在長安酒店眠",
      "倘遇唐王頒令召",
      "重呼不上木蘭船"
    ]
  },
  {
    "number": 61,
    "name": "岳飛受劫",
    "level": "下下签",
    "poem": [
      "十二金牌速召回",
      "奸雄設計幾時靈",
      "可憐一旦功勞散",
      "老少扶車不斷哀"
    ]
  },
  {
    "number": 62,
    "name": "美玉藏金",
    "level": "中平签",
    "poem": [
      "美玉於斯韞匱藏",
      "休求善價費商量",
      "沽之亦可隨相待",
      "此物何須自看常"
    ]
  },
  {
    "number": 63,
    "name": "顏回守道",
    "level": "中吉签",
    "poem": [
      "陋巷簞瓢不足愁",
      "傍人見此甚為憂",
      "不知樂道忘貧之",
      "亞聖芳名萬古留"
    ]
  },
  {
    "number": 64,
    "name": "孟之反奔",
    "level": "中吉签",
    "poem": [
      "奔殿須知上古人",
      "入門策馬不誇能",
      "敗師誰肯甘從後",
      "託謂鳴驄畏苦辛"
    ]
  },
  {
    "number": 65,
    "name": "陳後主失位",
    "level": "下下签",
    "poem": [
      "隋滅陳時戰伐紛",
      "都因妖媚閉明君",
      "陳奔西赴無藏息",
      "井裡胭脂隱玉人"
    ]
  },
  {
    "number": 66,
    "name": "王羲之會群賢",
    "level": "上吉签",
    "poem": [
      "蘭亭雅會眾群賢",
      "曲水流觴舍管絃",
      "天朗氣清風惠暢",
      "茂林修竹樂怡然"
    ]
  },
  {
    "number": 67,
    "name": "霸王自縊",
    "level": "中平签",
    "poem": [
      "人雖勇力不能當",
      "莫恃英雄獨冠場",
      "可挾泰山超北海",
      "身心猶貴重存亡"
    ]
  },
  {
    "number": 68,
    "name": "姜太公遇文王",
    "level": "中吉签",
    "poem": [
      "久抱凌雲志未舒",
      "荷竿渭水釣遊魚",
      "文王千里求賢士",
      "滅紂興周任意如"
    ]
  },
  {
    "number": 69,
    "name": "韓文公祭鱷魚",
    "level": "中吉签",
    "poem": [
      "忠義存心官十載",
      "年豐民樂惠難忘",
      "鱷魚毒害都能息",
      "禱告長江北海王"
    ]
  },
  {
    "number": 70,
    "name": "塞翁失馬",
    "level": "中平签",
    "poem": [
      "可比當年一塞翁",
      "雖然失馬半途中",
      "不知禍福真何是",
      "到底方明事始終"
    ]
  },
  {
    "number": 71,
    "name": "莊周活鮒魚",
    "level": "中平签",
    "poem": [
      "涸轍之中鮒困之",
      "窮通自可卜當時",
      "若能引得西江水",
      "他日成龍也未知"
    ]
  },
  {
    "number": 72,
    "name": "守株待兔",
    "level": "中平签",
    "poem": [
      "兔兒久待意何如",
      "堪嘆愚人獨守株",
      "算是無能令我笑",
      "不須守舊自拘拘"
    ]
  },
  {
    "number": 73,
    "name": "倫文叙高中",
    "level": "上上签",
    "poem": [
      "夾道花香襯馬蹄",
      "藍袍改換錦衣歸",
      "滿街紅粉皆爭羨",
      "翹首芳名雁塔題"
    ]
  },
  {
    "number": 74,
    "name": "朱買臣分妻",
    "level": "下下签",
    "poem": [
      "回憶當年運蹇時",
      "夫妻反目兩分離",
      "名題雁塔歸來候",
      "覆水馬頭時否悲"
    ]
  },
  {
    "number": 75,
    "name": "倫文叙分妻",
    "level": "下下签",
    "poem": [
      "婚姻豈可厭家貧",
      "文叙夫妻兩拆分",
      "一旦首登龍虎榜",
      "戲妻樓墜自亡身"
    ]
  },
  {
    "number": 76,
    "name": "孔夫子守道",
    "level": "中平签",
    "poem": [
      "人能樂道自修身",
      "疏水曲肱豈厭貧",
      "不義而富且貴者",
      "我心都是作浮雲"
    ]
  },
  {
    "number": 77,
    "name": "公冶長受劫",
    "level": "中平签",
    "poem": [
      "鳥語能通公冶長",
      "南山得箇虎抬羊",
      "其身雖在於縲絏",
      "到底非關自己殃"
    ]
  },
  {
    "number": 78,
    "name": "曾點言志",
    "level": "上吉签",
    "poem": [
      "瑟希鏗爾尚留聲",
      "春暮時剛春服成",
      "冠五六人童六七",
      "舞雩歸詠暢幽情"
    ]
  },
  {
    "number": 79,
    "name": "蘇秦封相",
    "level": "中平签",
    "poem": [
      "富貴有如春夢熟",
      "世人何苦力爭求",
      "任他秉笏當朝立",
      "到死惟留土一坏"
    ]
  },
  {
    "number": 80,
    "name": "杯中弓映",
    "level": "中吉签",
    "poem": [
      "飛觴對舞幾時賒",
      "弓影橫杯悞食蛇",
      "猜透詩中元妙訣",
      "泰來否極事無差"
    ]
  },
  {
    "number": 81,
    "name": "子路射雌",
    "level": "中吉签",
    "poem": [
      "山梁雌雉得其時",
      "上下飛鳴自樂之",
      "色舉須知翔後集",
      "作聲三嗅過山欹"
    ]
  },
  {
    "number": 82,
    "name": "孔子在衛",
    "level": "中平签",
    "poem": [
      "聖人擊磬在於衛",
      "誰料過門有荷簣",
      "嗟嘆有心挽道窮",
      "可憐日月今將逝"
    ]
  },
  {
    "number": 83,
    "name": "人心不足",
    "level": "中平签",
    "poem": [
      "凡麈身歷幾時閒",
      "世事渾如叠叠山",
      "既富尚憂無貴子",
      "不知花放又花殘"
    ]
  },
  {
    "number": 84,
    "name": "韓信投軍",
    "level": "中吉签",
    "poem": [
      "滿腹奇才志未沖",
      "鉄鷄難舉意無容",
      "張良指示身投漢",
      "項羽烏江命自窮"
    ]
  },
  {
    "number": 85,
    "name": "劉向高中",
    "level": "上吉签",
    "poem": [
      "太乙燃藜照讀書",
      "十年窗下苦功舒",
      "揚眉吐氣袍穿錦",
      "駟馬高車擁道隨"
    ]
  },
  {
    "number": 86,
    "name": "陶侃母留名萬載",
    "level": "中吉签",
    "poem": [
      "截髮迎賓否也貧",
      "貧中賢婦更何人",
      "古今只有陶侃母",
      "所以名留萬代聞"
    ]
  },
  {
    "number": 87,
    "name": "兩雄相遇",
    "level": "中平签",
    "poem": [
      "會談華座逞英雄",
      "究竟誰人秉大公",
      "一云日下荀鳴鶴",
      "一說雲間陸士龍"
    ]
  },
  {
    "number": 88,
    "name": "木蘭從軍",
    "level": "中吉签",
    "poem": [
      "替父從軍膽氣雄",
      "鬚眉巾幗幾人同",
      "以身報國忠而孝",
      "笑煞當時眾鉅公"
    ]
  },
  {
    "number": 89,
    "name": "吳季子掛劍",
    "level": "下下签",
    "poem": [
      "他邦遠歷佩魚腸",
      "誰料徐君意欲將",
      "既返願為相贈答",
      "且懸樹下表情長"
    ]
  },
  {
    "number": 90,
    "name": "紅拂女私奔",
    "level": "中平签",
    "poem": [
      "細整殘粧夜欲奔",
      "座中李靖更何人",
      "那知虬髯情鍾處",
      "拔劍三回未敢陳"
    ]
  },
  {
    "number": 91,
    "name": "蔡中興高中",
    "level": "上上签",
    "poem": [
      "蟾官月殿桂飄香",
      "玉篋團圓萬里光",
      "六水三山歸鏡裏",
      "無瑕一片掛穹蒼"
    ]
  },
  {
    "number": 92,
    "name": "孔夫子周遊列國",
    "level": "中吉签",
    "poem": [
      "至聖周遊列國行",
      "在齊得聽奏韶聲",
      "三月不知嘉肉味",
      "善哉大道可功成"
    ]
  },
  {
    "number": 93,
    "name": "鄭王失位",
    "level": "下下签",
    "poem": [
      "鄭衛之音不忍聽",
      "淫風敗俗國將傾",
      "令人深入迷津路",
      "所奏全非古樂聲"
    ]
  },
  {
    "number": 94,
    "name": "兩虎相爭",
    "level": "中平签",
    "poem": [
      "一窟難藏兩虎兒",
      "乘風別嶺各棲之",
      "名山自守為巢穴",
      "可免傷殘後悔遲"
    ]
  },
  {
    "number": 95,
    "name": "女媧氏",
    "level": "中平签",
    "poem": [
      "功勤一簣可成山",
      "由少而多莫憚煩",
      "作事畏辛今汝畫",
      "補天煉石亦無難"
    ]
  },
  {
    "number": 96,
    "name": "文姬思漢",
    "level": "中平签",
    "poem": [
      "姜笛頻吹韻更悲",
      "異鄉作客觸歸期",
      "南來孤雁如憐我",
      "煩寄家書轉達知"
    ]
  },
  {
    "number": 97,
    "name": "康順釣魚",
    "level": "中平签",
    "poem": [
      "憑欄晚眺倚南樓",
      "滿目風光景色幽",
      "一葉小舟頻下餌",
      "漁翁釣得有魚無"
    ]
  },
  {
    "number": 98,
    "name": "掘地尋金",
    "level": "中平签",
    "poem": [
      "入山種玉嫌田狹",
      "掘地尋金厭客多",
      "富貴貧窮天注定",
      "世人何苦力奔波"
    ]
  },
  {
    "number": 99,
    "name": "韓文公遇雪",
    "level": "中平签",
    "poem": [
      "雪擁橋頭馬不前",
      "風狂漁父莫開船",
      "水流花謝人誰惜",
      "早立堅心志勿偏"
    ]
  },
  {
    "number": 100,
    "name": "百花開放",
    "level": "中吉签",
    "poem": [
      "百花競放賀陽春",
      "萬物從今盡轉新",
      "末數莫言窮運至",
      "不知否極泰來頻"
    ]
  }
]
